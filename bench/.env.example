# Copy to .env and fill in values.

# OHLCV source — same stocks database used by the Rust benchmarks
STOCKS_DATABASE_URL=postgresql://tulip:tulip@localhost:5432/stocks

# Benchmark result store — same indicator_benchmark database
BENCHMARK_DATABASE_URL=postgresql://tulip:tulip@localhost:5432/indicator_benchmark

# Set to 1 to write rows to the database; 0 = stdout/dry-run only
BENCHMARK_LOG_TO_DB=0

# Timing knobs — increase for more stable measurements
# Number of back-to-back calls inside one timing sample
BENCH_NUMBER=10
# Number of independent timing samples (used for mean/min/max/stddev)
BENCH_REPEAT=30
